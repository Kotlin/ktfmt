// MAX_WIDTH 24
// TRAILING_COMMA_STRATEGY NONE

fun main() {
  foo(
      3,
  )

  foo<Int>(
      3,
  )

  foo<
      Int,
  >(
      3,
  )

  foo<Int>(
      "asdf", "asdf")

  foo<
      Int,
  >(
      "asd",
      "asd",
  )

  foo<
      Int,
      Boolean,
  >(
      3,
  )
}

fun foo() {
  foo(
      { it },
  )
}
