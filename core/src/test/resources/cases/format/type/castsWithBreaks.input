fun castIt(
    something: Any
) {
  doIt(
      something
          as List<*>)
  doIt(
      something
          is List<*>)
  println(
      something
          is
          List<String>)
  doIt(
      something
          as
          List<String>)
  println(
      something
          is
          PairList<
              String,
              Int>)
  doIt(
      something
          as
          PairList<
              String,
              Int>)
  println(
      a is Int &&
          b is String)
  l.b?.s?.sOrNull() is
      SomethingLongEnough
}

val a =
    l.sOrNull() is
        SomethingLongEnough
