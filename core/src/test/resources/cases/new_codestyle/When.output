fun f() {
  val teamsAffected =
      when (val event = state.lastEvent) {
        is CommentaryMessagesUpdate -> emptyList()
        is InfoUpdate -> info.teams.keys.toList()
        is RunUpdate -> {
          lastSubmissionTime = maxOf(lastSubmissionTime, event.newInfo.time)
          runsByTeamId.applyEvent(state)
        }
      }
}
