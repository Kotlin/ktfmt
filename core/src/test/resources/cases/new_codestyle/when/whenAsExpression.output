          else -> "other"
        }
}

fun g(x: Int): Int {
  val someVeryLongVariableNameGoesHere =
      when (x) {
        1 -> 1
        else -> 2
      }
  consume(
      when (x) {
        1 -> "one"
        else -> "many"
      },
      secondArgument,
  )
  register(
      name = "handler",
      body =
          when (x) {
            1 -> "one"
            else -> "many"
          },
  )
  return when (x) {
    1 -> 1
    else -> 2
  }.also { println(it) }
