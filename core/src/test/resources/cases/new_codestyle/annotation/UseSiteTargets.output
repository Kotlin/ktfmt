// MAX_WIDTH 60

@get:Rule val propertyTargetFits: ExpectedException = none()

@set:Magic(name = "Jane", tag = "long")
var propertyTargetOverflows: String

@[JvmStatic Volatile]
var groupedFits: String? = null

@field:[Inject Named("WEB_VIEW") Suppress("UNUSED")]
lateinit var groupedOverflows: Client

class OnParameterFits(
    @field:[A B]
    val x: Int,
)

class OnParameterOverflows(
    @field:[JvmStatic Volatile Suppress("X")]
    val x: Int,
)
