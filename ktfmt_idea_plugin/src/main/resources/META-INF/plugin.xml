<idea-plugin url="https://github.com/Kotlin/ktfmt/tree/main/ktfmt_idea_plugin">
    <id>org.jetbrains.ktfmt_idea_plugin</id>
    <!--suppress PluginXmlCapitalization -->
    <name>ktfmt</name>
    <vendor url="https://github.com/Kotlin/ktfmt">JetBrains</vendor>

    <description>ktfmt is a program that reformats Kotlin source code to comply with the common community standard for
        Kotlin code conventions.
    </description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <formattingService
                implementation="org.jetbrains.ktfmt.intellij.KtfmtFormattingService"/>
        <postStartupActivity implementation="org.jetbrains.ktfmt.intellij.InitialConfigurationStartupActivity"/>
        <!--suppress PluginXmlCapitalization -->
        <projectConfigurable instance="org.jetbrains.ktfmt.intellij.KtfmtConfigurable"
                             id="org.jetbrains.ktfmt_idea_plugin.settings"
                             displayName="Ktfmt Settings"
                             parentId="editor"/>
        <notificationGroup displayType="STICKY_BALLOON" id="Enable ktfmt"
                           isLogByDefault="false"/>
    </extensions>

</idea-plugin>
